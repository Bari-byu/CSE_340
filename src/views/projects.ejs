<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>

    <% if (projects && projects.length) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong> -
                    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    <p><%= project.description %></p>
                    <small><%= project.location %> &mdash; <%= project.date %></small>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No projects are available right now.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
