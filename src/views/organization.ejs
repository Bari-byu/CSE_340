<%- include('partials/header') %>
<main>
    <h1><%= organization.name %></h1>
    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

    <p><%= organization.description %></p>
    <p><strong>Contact:</strong> <%= organization.contact_email %></p>

    <h2>Service Projects</h2>
    <% if (projects && projects.length) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>This organization does not have any service projects yet.</p>
    <% } %>

    <p><a href="/organizations">&larr; Back to all partner organizations</a></p>
</main>

<%- include('partials/footer') %>
